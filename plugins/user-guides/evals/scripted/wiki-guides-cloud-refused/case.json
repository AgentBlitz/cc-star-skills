{
  "name": "wiki-guides-cloud-refused",
  "description": "Cloud refused (scripted; D6): the page named is on a wiki that looks like Confluence Cloud (the mock's cloud mode). Even with the go-ahead, /user-guides:wiki-guides detects the flavour, refuses, sends nothing, and offers HTML files.",
  "prompt": "/user-guides:wiki-guides destination=confluence guides=all under={{under}} release=1.0 go-ahead=yes",
  "model": "sonnet",
  "max_turns": 60,
  "timeout_seconds": 1200,
  "allowed_tools": ["Read", "Glob", "Grep", "Bash", "Write", "Edit", "Skill"],
  "runs": 2,
  "baseline_runs": 1,
  "scaffold": "scaffold.mjs",
  "graders": [
    { "type": "regex", "name": "edited-copy-ran", "target": "trace", "pattern": "user-guides-eval\\.[A-Za-z0-9]+/plugin/skills/wiki-guides", "arm": "with-only" },
    { "type": "tool_used", "name": "detected-the-flavour", "tool": "Bash", "input_match": "publish-node\\.mjs (detect|plan|test|publish)", "arm": "with-only" },
    { "type": "script", "name": "nothing-written", "module": "graders/nothing-written.mjs" },
    { "type": "regex", "name": "says-cloud-is-refused", "target": "last_message", "pattern": "Cloud[\\s\\S]*Data Center|Data Center[\\s\\S]*Cloud" },
    { "type": "regex", "name": "offers-html", "target": "last_message", "pattern": "HTML", "flags": "i" },
    { "type": "regex", "name": "never-asks-for-a-token", "target": "last_message", "pattern": "token|password|API key|credential", "flags": "i", "match": "not_contains" }
  ]
}
