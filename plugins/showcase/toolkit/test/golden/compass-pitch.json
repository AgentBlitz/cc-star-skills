{
  "$schema": "../../schema/tour.schema.json",
  "showcase": 1,
  "id": "compass-pitch",
  "title": "The 2-minute pitch",
  "meta": {
    "kind": "pitch",
    "audience": "executives",
    "afterwards": "decide",
    "takeaway": "Compass turns the Monday numbers into a story the exec team can act on.",
    "language": "en-GB",
    "length": {
