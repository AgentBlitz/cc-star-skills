{
  "$schema": "../.schema/tour.schema.json",
  "showcase": 1,
  "id": "walkthrough",
  "title": "Replace with the walkthrough's title",
  "meta": {
    "kind": "walkthrough",
    "audience": "users",
    "afterwards": "try",
    "takeaway": "Replace with the one line the viewer should believe afterwards.",
    "language": "en-GB",
