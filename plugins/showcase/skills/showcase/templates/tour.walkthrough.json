    "home": {
      "css": "main",
      "text": "Replace with the home screen's heading"
    },
    "hero": {
      "role": "region",
      "name": "Replace with the hero area's name"
    },
    "action": {
      "role": "button",
      "name": "Replace with the button's label"
    },
    "field": {
      "label": "Replace with the field's label"
    },
    "result": {
      "css": "[data-showcase=result]"
    },
    "detail": {
      "testId": "replace-with-a-test-id"
    }
  },
  "steps": [
    {
      "id": "open",
      "title": "What this is",
      "path": "/",
      "beats": [
        {
          "id": "open",
          "card": {
            "title": "Replace with the product's name",
            "lines": [
              "Replace with what it helps people do"
            ]
          },
          "narration": [
            "Open with what the product is for, in a single plain line.",
            "Say who it is for, and what they will be able to do after watching."
          ],
          "actions": [],
          "dwellMs": 400
        }
      ]
    },
    {
      "id": "orient",
      "title": "Find your way around",
      "path": "/",
      "beats": [
        {
          "id": "orient",
          "narration": [
            {
              "text": "Start on the home screen, and show where everything lives.",
              "after": "orient-look"
            },
            "Point out the two or three places the viewer will use most.",
            "Skip the settings: nobody watches a tour for those."
          ],
          "actions": [
            {
              "id": "orient-look",
              "kind": "spotlight",
              "target": "@home"
            },
            {
              "id": "orient-seen",
              "kind": "hold",
              "ms": 2000
            }
          ]
        }
      ]
    },
