    {
      "id": "goal",
      "title": "The goal",
      "path": "/",
      "beats": [
        {
          "id": "goal",
          "card": {
            "title": "Replace with: How to …",
            "lines": [
              "Replace with what you'll have at the end"
            ]
          },
          "narration": [
            "Say what the viewer will have at the end, in one line.",
            "Keep it to the outcome, not the steps."
          ],
          "actions": [],
          "dwellMs": 400
        }
      ]
    },
    {
      "id": "start",
      "title": "Where to start",
      "path": "/",
      "beats": [
        {
          "id": "start",
          "narration": [
            {
              "text": "Begin from the screen where the task starts.",
              "after": "start-look"
            },
            "Say how to get here, if it isn't obvious."
          ],
          "actions": [
            {
              "id": "start-look",
              "kind": "spotlight",
              "target": "@home"
            },
            {
              "id": "start-seen",
              "kind": "hold",
              "ms": 1500
            }
          ]
        }
      ]
    },
    {
