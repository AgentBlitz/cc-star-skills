{
  "$schema": "../.schema/tour.schema.json",
  "showcase": 1,
  "id": "howto",
  "title": "Replace with: How to …",
  "meta": {
    "kind": "howto",
    "audience": "users",
    "afterwards": "understand",
    "takeaway": "Replace with the one line the viewer should believe afterwards.",
    "language": "en-GB",
    "length": {
      "targetSec": 120
    },
    "rules": {
      "spokenNumbers": "on-screen-only",
      "firstToCut": "step-4"
    }
  },
  "anchors": {
    "home": {
      "css": "main",
      "text": "Replace with the home screen's heading"
    },
    "hero": {
      "role": "region",
      "name": "Replace with the hero area's name"
    },
    "action": {
      "role": "button",
      "name": "Replace with the button's label"
    },
    "field": {
      "label": "Replace with the field's label"
    },
    "result": {
      "css": "[data-showcase=result]"
    },
    "detail": {
      "testId": "replace-with-a-test-id"
    }
  },
