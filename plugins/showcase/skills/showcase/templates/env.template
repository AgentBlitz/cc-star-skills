# showcase user key file — read by `showcase` in every repo (PLAN §2.3).
# Keep this file at mode 600 and its directory at 700. Never commit or paste it.
# Check what is set with `showcase keys status`; set the key with `showcase keys set`.

# Needed for the final voice (OpenRouter TTS). Without it the draft voice carries the work.
OPENROUTER_API_KEY=

# Optional narrator overrides.
# SHOWCASE_TTS_MODEL=
# SHOWCASE_TTS_VOICE=
# SHOWCASE_TTS_INSTRUCTIONS=
# SHOWCASE_TTS_SPEED=

# Reserved for direct providers later; not read in v1.
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
