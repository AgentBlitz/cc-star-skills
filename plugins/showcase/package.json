{
  "name": "showcase-toolkit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"toolkit/test/**/*.test.ts\"",
    "test:next": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"toolkit/test/next/*.e2e.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p toolkit/spikes && tsc --noEmit -p toolkit/runtime && tsc --noEmit -p toolkit/host",
    "spikes": "node --disable-warning=ExperimentalWarning toolkit/spikes/run-all.ts",
    "build:runtime": "node --disable-warning=ExperimentalWarning toolkit/runtime/build.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2"
  }
}
