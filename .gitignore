.DS_Store
node_modules/

# autopilot's per-run logs (costs, session ids): local only
.planning/*/autopilot/

# showcase plugin: generated output, caches, sign-ins
**/showcase/out/
**/showcase/.cache/
**/showcase/.auth/
plugins/showcase/toolkit/test/.out/
plugins/showcase/evals/results/

# user-guides plugin: transcript copies (internal hosts), test output, eval results
.planning/user-guides/sources/
plugins/user-guides/test/.out/
plugins/user-guides/evals/results/
